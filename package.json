{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "portless harmony-rooster nuxt dev",
    "dev:all": "concurrently --kill-others --names nuxt,stripe --prefix-colors green,magenta pnpm:dev pnpm:stripe:listen",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "stripe:listen": "stripe listen --all-snapshot --forward-to http://harmony-rooster.localhost:1355/api/stripe/webhook",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "postinstall": "nuxt prepare",
    "prepare": "vp config"
  },
  "dependencies": {
    "@formkit/tempo": "^0.1.2",
    "@nuxtjs/seo": "^5.3.10",
    "@posthog/nuxt": "^1.5.58",
    "@upstash/redis": "^1.37.0",
    "@vee-validate/nuxt": "^4.15.1",
    "@vee-validate/zod": "^4.15.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vue-email/components": "0.0.21",
    "@vue-email/render": "0.0.9",
    "airtable-ts": "^1.10.0",
    "h3": "^1.15.11",
    "reka-ui": "^2.8.2",
    "resend": "^6.9.4",
    "stripe": "^19.3.0",
    "ufo": "^1.6.3",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.93",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "^1.15.0",
    "@nuxt/image": "^1.11.0",
    "@nuxt/kit": "^4.3.1",
    "@nuxt/schema": "^4.3.1",
    "@unlok-co/nuxt-stripe": "5.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "concurrently": "^10.0.6",
    "nuxt": "^4.3.1",
    "nuxt-security": "2.4.0",
    "nuxt-svgo": "^4.2.6",
    "postcss-nesting": "^13.0.2",
    "rolldown": "^1.2.13",
    "typescript": "^5.9.3",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.33.0"
}
